<resources>
    <!-- Dark theme: explicit surface / onSurface so text stays readable across API levels. -->
    <style name="Theme.ShoppingList" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_200</item>
        <item name="colorPrimaryVariant">@color/teal_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/night_background</item>
        <item name="colorSurface">@color/night_surface</item>
        <item name="colorOnSurface">@color/night_on_surface</item>
        <item name="colorOnBackground">@color/night_on_surface</item>
        <item name="android:textColorPrimary">@color/night_on_surface</item>
        <item name="android:textColorSecondary">#FFB0B0B0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialButtonStyle">@style/Widget.ShoppingList.Button.Primary</item>
    </style>
</resources>
